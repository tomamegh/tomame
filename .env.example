# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=your-secret-key

# Hubtel — Receive Money Prompt (mobile money)
# API ID / API Key are the Basic-auth credentials from the merchant portal.
HUBTEL_API_ID=your-hubtel-api-id
HUBTEL_API_KEY=your-hubtel-api-key
# Merchant Account Number (POS Sales ID) that receives the funds.
HUBTEL_MERCHANT_ACCOUNT_NUMBER=2019940
# Hubtel does not sign callbacks — this secret in the callback URL path is what
# keeps the webhook private. Generate with: openssl rand -hex 32
HUBTEL_CALLBACK_SECRET=
# Optional host overrides (defaults shown)
# HUBTEL_RMP_BASE_URL=https://rmp.hubtel.com
# HUBTEL_STATUS_BASE_URL=https://api-txnstatus.hubtel.com

# Resend
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=Tomame <no-reply@tomame.com>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Browserless
BROWSERLESS_API_KEY=your-browserless-api-key

# Apify (Amazon scraping fallback)
APIFY_API_TOKEN=your-apify-api-token

# SerpAPI (weight lookup fallback)
SERPAPI_API_KEY=your-serpapi-key


# CRON
CRON_SECRET=

# FREE CURRENCY
FREECURRENCY_API_KEY=freecurrency-api-key

# EXCHANGE RATE API
EXCHANGE_RATE_API_KEY=
