# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxx

# Resend
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=Tomame <no-reply@tomame.ca>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# ── Extraction pipeline ───────────────────────────────────────────────────────
# Required. Headless Chrome for pages that block a plain fetch (Amazon, SHEIN).
BROWSERLESS_API_KEY=
BROWSERLESS_API_URL=https://production-sfo.browserless.io
# Required. Claude structured extraction — fills whatever the parsers missed
# (weight, price on odd layouts) and reads any store with no dedicated parser.
ANTHROPIC_API_KEY=
# Recommended. ScraperAPI (scraperapi.com) structured endpoints — Amazon and eBay
# product JSON in 2–5 s, so those quotes skip the browser entirely.
SCRAPERAPI_API_KEY=
# Optional. Rainforest API — second Amazon product-data source.
RAINFOREST_API_KEY=
# Optional. Apify community actors, last-resort tier. Skipped when blank.
APIFY_API_TOKEN=

# ── Exchange rates ────────────────────────────────────────────────────────────
# Required. Primary provider (exchangerate-api.com).
EXCHANGE_RATE_API_KEY=
# Optional. Fallback provider (freecurrencyapi.com). Skipped when blank.
FREECURRENCY_API_KEY=
