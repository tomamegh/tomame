{
  "id": "/warehouse",
  "name": "Tomame Warehouse",
  "short_name": "Tomame Hub",
  "description": "Receive, box and ship Tomame orders.",
  "start_url": "/warehouse",
  "scope": "/warehouse",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#fdf0e0",
  "theme_color": "#fdf9f6",
