# Copy to secrets.auto.tfvars and fill in. That filename is gitignored, and
# Terraform loads *.auto.tfvars automatically — no exports, no shell state, so
# it works from any terminal and from an agent session that does not inherit
# your environment.
#
#     cp secrets.auto.tfvars.example secrets.auto.tfvars
#     $EDITOR secrets.auto.tfvars
#
# Delete it when you are done, or keep it — it never leaves this machine.

# vercel.com/account/tokens — scope it to the albertahadjie-6953s-projects team.
vercel_api_token = ""

# supabase.com/dashboard/account/tokens (starts sbp_).
supabase_access_token = ""

# resend.com/api-keys — FULL ACCESS. Terraform uses this only to create the
# sending domain and mint the app a separate send-only key. Not the app's key.
#
# Only read when root_domain is set. dev.tfvars has root_domain = null, so a
# first dev apply never calls Resend — leave this empty for that run.
resend_api_token = ""

# Vendor credentials with no API to mint them. All seven keys must be present
# and non-empty or the plan fails.
#
# ⚠️ The values currently in .env are PLACEHOLDERS, except FREECURRENCY_API_KEY.
# They will pass validation and deploy a storefront whose checkout fails,
# because Paystack rejects a placeholder key. Fine for a throwaway dev apply
# nobody touches; never for anything a customer reaches.
third_party_secrets = {
  PAYSTACK_SECRET_KEY             = ""
  NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY = ""
  APIFY_API_TOKEN                 = ""
  BROWSERLESS_API_KEY             = ""
  SERPAPI_API_KEY                 = ""
  FREECURRENCY_API_KEY            = ""
  EXCHANGE_RATE_API_KEY           = ""
}
